# REFERENCE ONLY. Do not replace an existing .env or change its credentials.
# Add only the settings you need. Existing process variables override .env.
# Shared Telegram defaults; enabled slots may override these independently.
API_ID=
API_HASH=
TARGET_CHAT_ID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Preview is the default and consumes the same durable quotas as real sends.
AUTO_SEND=false
MAX_ACTIONS_PER_HOUR=5

# Independent five-message account limits; optional combined group ceiling.
GROUP_MAX_ACTIONS_PER_HOUR=25
HOURLY_WINDOW_MODE=fixed
REPORT_TIMEZONE=Africa/Lagos
COORDINATOR_DATABASE_PATH=data/coordinator.sqlite3
GROQ_CONCURRENCY=1
GROQ_REQUESTS_PER_MINUTE=20
GROQ_REQUESTS_PER_DAY=1000
GROQ_TOKENS_PER_MINUTE=10000
GROQ_TOKENS_PER_DAY=200000
ACCOUNT_RESTART_DELAY_SECONDS=30

# Operator attestations. Live mode requires group permission AND disclosure
# for EVERY enabled account. These flags do not change profiles or post notices.
GROUP_AUTOMATION_ALLOWED=false
AUTOMATION_DISCLOSED=false

# Existing account: keep its existing credentials and activity history.
# Leave path overrides absent to detect the old root session and database.
# First runtime/login copies a legacy session into sessions/account_1.session,
# retaining the original. Existing activity_account_1.sqlite3 stays in place.
ACCOUNT_1_ENABLED=true
ACCOUNT_1_AUTOMATION_DISCLOSED=false
# ACCOUNT_1_API_ID=12345
# ACCOUNT_1_API_HASH=replace_with_account_1_api_hash
# ACCOUNT_1_TARGET_CHAT_ID=-1001234567890
# ACCOUNT_1_SESSION_PATH=sessions/account_1
# ACCOUNT_1_DATABASE_PATH=data/activity_account_1.sqlite3

# Additional accounts stay disabled until you explicitly configure and enable.
# Empty API credential overrides inherit shared API_ID/API_HASH.
# Every account still needs a different phone login and separate session.
ACCOUNT_2_ENABLED=false
ACCOUNT_2_AUTOMATION_DISCLOSED=false
ACCOUNT_2_API_ID=
ACCOUNT_2_API_HASH=
# ACCOUNT_2_TARGET_CHAT_ID=-1001234567890
# ACCOUNT_2_SESSION_PATH=sessions/account_2
# ACCOUNT_2_DATABASE_PATH=data/activity_account_2.sqlite3

ACCOUNT_3_ENABLED=false
ACCOUNT_3_AUTOMATION_DISCLOSED=false
ACCOUNT_3_API_ID=
ACCOUNT_3_API_HASH=
# ACCOUNT_3_TARGET_CHAT_ID=-1001234567890
# ACCOUNT_3_SESSION_PATH=sessions/account_3
# ACCOUNT_3_DATABASE_PATH=data/activity_account_3.sqlite3

ACCOUNT_4_ENABLED=false
ACCOUNT_4_AUTOMATION_DISCLOSED=false
ACCOUNT_4_API_ID=
ACCOUNT_4_API_HASH=
# ACCOUNT_4_TARGET_CHAT_ID=-1001234567890
# ACCOUNT_4_SESSION_PATH=sessions/account_4
# ACCOUNT_4_DATABASE_PATH=data/activity_account_4.sqlite3

ACCOUNT_5_ENABLED=false
ACCOUNT_5_AUTOMATION_DISCLOSED=false
ACCOUNT_5_API_ID=
ACCOUNT_5_API_HASH=
# ACCOUNT_5_TARGET_CHAT_ID=-1001234567890
# ACCOUNT_5_SESSION_PATH=sessions/account_5
# ACCOUNT_5_DATABASE_PATH=data/activity_account_5.sqlite3

BATCH_DELAY_SECONDS=5
BATCH_SIZE=20
MAX_PENDING_AGE_SECONDS=720
LOG_LEVEL=INFO

# Fresh Groq starters require recent relevant human context and a quiet group.
# No repeat starter until a human participates; normal hourly limits apply.
QUIET_PERIOD_SECONDS=900
DISCUSSION_TOPICS=
# Legacy custom-decider topics only; production uses context-based Groq questions.

# Optional private dashboard. A separate restricted worker login publishes via RPC.
# Never use a service-role key. Never put these login fields in dashboard/.env.local.
TELEMETRY_ENABLED=false
TELEMETRY_SUPABASE_URL=
TELEMETRY_SUPABASE_PUBLISHABLE_KEY=
TELEMETRY_WORKER_EMAIL=
TELEMETRY_WORKER_PASSWORD=
TELEMETRY_WORKER_ID=local-worker

# Existing ACCOUNT_ID, SESSION_PATH and DATABASE_PATH remain supported for slot 1.
# Do not change ACCOUNT_ID or DATABASE_PATH to bypass existing activity history.
# PREVIEW_ENFORCE_COOLDOWN is obsolete: preview limits are always enforced.
# AI_PROVIDER is obsolete: inference uses the configured Groq API directly.
